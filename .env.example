# Run python3 scripts/setup.py to create a private .env with random local secrets.
PHONEASE_API_TOKEN=local-demo
AGENT_SERVICE_TOKEN=replace-with-random-service-token
POSTGRES_USER=phonease
POSTGRES_PASSWORD=replace-with-random-database-password
POSTGRES_DB=phonease
UI_PORT=5173
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
# Neural browser speech; independent of the conversation-analysis model.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
TELEPHONY_ENABLED=false
PUBLIC_BASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TEST_NUMBERS=
HUMAN_TEST_NUMBER=
# Twilio <Say> voice. Default is an Amazon Polly neural voice; set empty for Twilio's standard voice.
TWILIO_VOICE=Polly.Olivia-Neural
